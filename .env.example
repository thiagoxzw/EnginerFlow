# Copie para .env (não versionar). Valores abaixo são apenas de desenvolvimento local.

# Senha do PostgreSQL do docker-compose (ENGIFLOW_DB_PASSWORD deve bater com a URL abaixo).
ENGIFLOW_DB_PASSWORD=engiflow-dev-only

# API (apps/api). Use PostgreSQL via Docker; SQLite só para testes rápidos.
ENGIFLOW_DATABASE_URL=postgresql+psycopg://engiflow:engiflow-dev-only@127.0.0.1:5432/engiflow
ENGIFLOW_SESSION_TTL_HOURS=12
ENGIFLOW_COOKIE_SECURE=false
ENGIFLOW_FRONTEND_ORIGIN=http://127.0.0.1:3000
ENGIFLOW_LOG_LEVEL=INFO

# Web (apps/web): destino do proxy /api/v1/*
ENGIFLOW_API_URL=http://127.0.0.1:8000
